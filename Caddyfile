{
	email {$ACME_EMAIL}
}

{$APP_HOST} {
	encode zstd gzip

	handle /static/* {
		root * /srv
		file_server
	}

	handle_path /api/backend/* {
		reverse_proxy backend:8000 {
			header_up Host {hostport}
		}
	}

	handle /admin/* {
		reverse_proxy backend:8000 {
			header_up Host {hostport}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format json
	}
}
