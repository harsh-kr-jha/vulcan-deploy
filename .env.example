# Tamaso Customer Deployment Environment
# Copy to /opt/tamaso/.env and fill in all values.
# File permissions should be 0600.

# --- GCP / Artifact Registry ---
GCP_REGION=us-central1
GCP_PROJECT_ID=gentle-broker-505219-d0
AR_REPOSITORY=vulcan
IMAGE_PREFIX=mfg-da-auto-all-mypol
# GCS bucket for SQLite backups (create manually, enable soft-delete)
GCS_BACKUP_BUCKET=gentle-broker-505219-d0-vulcan-data

# --- Customer identity ---
CUSTOMER_ID=MYPOL
PLATFORM_VERSION=1.0.1

# --- Application host (use <IP>.sslip.io for auto-TLS, or a real domain) ---
APP_HOST=35.200.x.x.sslip.io
ACME_EMAIL=admin@example.com

# --- Django settings ---
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=generate-a-50-char-random-string-here
DJANGO_ALLOWED_HOSTS=35.200.x.x.sslip.io
DJANGO_CSRF_TRUSTED_ORIGINS=https://35.200.x.x.sslip.io
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_NUM_PROXIES=1

# --- Application variant ---
VULCAN_VARIANT=automotive
VULCAN_SINGLE_NODE=true
VULCAN_ADMIN_ENABLED=true

# --- Demo credentials (optional, for showcase deployments) ---
# MYPOL_DEMO_EMAIL=demo@example.com
# MYPOL_DEMO_PASSWORD=strong-password-here

# --- Set by deploy.sh (do not edit manually) ---
# BACKEND_IMAGE=
# FRONTEND_IMAGE=
# CONFIG_VERSION=
